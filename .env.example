# Everything is optional. Invoicer works with an empty .env.

# Built-in HTTPS with Let's Encrypt (map ports 80->8080 and 443->8443).
# Leave empty when a reverse proxy terminates TLS.
#TLS=auto
#ACME_EMAIL=you@example.com

# Timezone for logs (the app timezone is set in System settings).
#TZ=Europe/Paris

# Set to false to only notify about updates (critical/mandatory ones are still installed).
#AUTO_UPDATE=true
